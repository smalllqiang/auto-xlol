# Example environment variables. Copy to .env, fill in, then source it:
#   set -a; . ./.env; set +a
# Never commit the filled file.
NEWSTAR_BASE_URL=https://ol.lstyxl.com/
NEWSTAR_UNIVERSE=CQBX8573
NEWSTAR_USERNAME=your-user
NEWSTAR_PASSWORD=your-password
# 0 for instances with expired/self-signed certificates
NEWSTAR_VERIFY_SSL=0

# Optional
# NEWSTAR_TIMEOUT=20
# NEWSTAR_REQUEST_INTERVAL=0.25
# NEWSTAR_SESSION_FILE=.newstar-session.json
