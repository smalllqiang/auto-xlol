# 单文件配置：游戏账号 + 模型端点。
#
#   cp .env.example .env
#   # 填好下面的值，然后直接跑脚本即可（脚本会自动读 .env）
#
# .env 已在 .gitignore 里，不会被提交；但它是明文，请自己保管好。
# 优先级：命令行 > 环境变量 > 本文件 > passwd.txt

# --- 游戏实例 -------------------------------------------------------------
NEWSTAR_BASE_URL=https://ol.lstyxl.com/
NEWSTAR_UNIVERSE=CQBX8573
NEWSTAR_USERNAME=your-user
NEWSTAR_PASSWORD=your-password
# 0 = 跳过 TLS 校验（本实例证书已过期）
NEWSTAR_VERIFY_SSL=0

# --- 模型（scripts/agent.py 用；不填则 agent 拒绝运行）--------------------
# OpenAI 兼容端点：写到 .../v1 或完整的 .../v1/chat/completions 都可以。
# NEWSTAR_AGENT_BASE_URL=https://api.example.com/v1
# NEWSTAR_AGENT_MODEL=your-model
# NEWSTAR_AGENT_API_KEY=sk-...
# 可选：采样温度与超时（秒）
# NEWSTAR_AGENT_TEMPERATURE=0.2
# NEWSTAR_AGENT_TIMEOUT=60

# --- 可选 -----------------------------------------------------------------
# 游戏请求超时（秒）
# NEWSTAR_TIMEOUT=20
# 共享会话文件；默认 state/session.json（存在时自动使用）
# NEWSTAR_SESSION_FILE=state/session.json
# 会话策略：1 = 脚本优先（默认，失效时自动用账号密码重建并回写）
#           0 = 浏览器优先（失效时退出码 4，需手动 session.py import）
# NEWSTAR_RELOGIN=1
